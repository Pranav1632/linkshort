# Port for backend service
PORT=5000

# Redis Connection URL
REDIS_URL=redis://linkshort-redis:6379

# Application runtime environment
NODE_ENV=development

# Supabase PostgreSQL Connection String (Transaction pooler on port 6543)
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Clerk Authentication Keys (Optional - From clerk.com dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
